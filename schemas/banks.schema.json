{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "checkedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "banks": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "institution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "kind": {
            "default": "savings",
            "type": "string",
            "enum": [
              "savings",
              "cash-sweep",
              "checking-bundle"
            ]
          },
          "checkedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "rateAsOf": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "review"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "additionalSources": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "model": {
            "type": "string",
            "enum": [
              "flat",
              "whole-balance",
              "marginal",
              "rolling-payroll",
              "unsupported"
            ]
          },
          "apy": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "tiers": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "apy": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "from",
                "apy"
              ],
              "additionalProperties": false
            }
          },
          "qualifiedApy": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "qualificationDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "openingMinimum": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "monthlyFee": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "paperStatementFee": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "feeWaiverMinimum": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "maximumModeledBalance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "promotions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "startsOn": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "enrollBy": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "durationMonths": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "apyDelta": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "fixedApy": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "cap": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "conditions": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "name",
                "durationMonths",
                "conditions"
              ],
              "additionalProperties": false
            }
          },
          "bonuses": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "startsOn": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "enrollBy": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "balance",
                    "payroll"
                  ]
                },
                "fundingDays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                "maintainDays": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 730
                },
                "maintenance": {
                  "type": "string",
                  "enum": [
                    "average",
                    "minimum"
                  ]
                },
                "payoutDelayDays": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 365
                },
                "tiers": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "minimum": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "bonus": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "minimum",
                      "bonus"
                    ],
                    "additionalProperties": false
                  }
                },
                "conditions": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "name",
                "startsOn",
                "enrollBy",
                "kind",
                "fundingDays",
                "maintainDays",
                "maintenance",
                "payoutDelayDays",
                "tiers",
                "conditions"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "requirements": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "required": [
          "id",
          "name",
          "institution",
          "checkedOn",
          "rateAsOf",
          "verification",
          "sourceUrl",
          "evidence",
          "model",
          "apy",
          "openingMinimum",
          "monthlyFee"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "checkedOn",
    "currency",
    "policy",
    "banks"
  ],
  "additionalProperties": false,
  "$id": "https://mlo0352.github.io/hysacomp/schemas/banks.schema.json",
  "title": "Butter banks schema 2.0",
  "description": "Also run CLI validate for semantic date, uniqueness, eligibility and cross-file checks."
}

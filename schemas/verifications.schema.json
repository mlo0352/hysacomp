{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "butter-personal-verifications"
    },
    "entries": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bankId": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "evidenceSnapshot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150000
          },
          "checkedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "confirmed",
              "disputed",
              "needs-check"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourceTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "productScope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "bankId",
          "target",
          "evidenceSnapshot",
          "checkedOn",
          "outcome",
          "sourceUrl",
          "sourceTitle",
          "section",
          "productScope",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "https://mlo0352.github.io/hysacomp/schemas/verifications.schema.json",
  "title": "Butter verifications schema 1.0",
  "description": "Personal notes only. Use CLI verifications with a bank file to check evidence state."
}
